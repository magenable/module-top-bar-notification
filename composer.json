{
    "name": "magenable/module-top-bar-notification",
    "description": "Magento 2 extension to display simple notice at the top of the page",
    "type": "magento2-module",
    "version": "1.3.12",
    "license": "MIT",
    "require": {
        "php": ">=7.1.0",
        "magenable/module-base": "*"
    },
    "authors": [
        {
            "name": "Magenable",
            "homepage": "https://magenable.com.au"
        }
    ],
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Magenable\\TopBarNotification\\": ""
        }
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
